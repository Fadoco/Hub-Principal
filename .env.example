# Optional: replace with a compatible weather endpoint
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Milliseconds. Respect the limits of the configured providers.
VITE_WEATHER_UPDATE_INTERVAL=300000

# Set this after deploying worker/wrangler.toml. Leave blank to use Google News links only.
VITE_NEWS_API_URL=
